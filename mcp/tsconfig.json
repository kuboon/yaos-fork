{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM"],
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src/**/*.ts", "cloudflare.config.ts"]
}
